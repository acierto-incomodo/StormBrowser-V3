{
  "name": "stormbrowser-v3",
  "version": "1.0.0",
  "description": "StormBrowser - A modern browser by StormGamesStudios",
  "main": "main.js",
  "author": "StormGamesStudios <meliodas.aitor@gmail.com>",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.stormgamesstudios.stormbrowser",
    "productName": "StormBrowser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "acierto-incomodo",
      "repo": "StormBrowser-V3"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "renderer/assets/img/logo-256x256.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "differentialPackage": true,
      "include": "installer.nsh",
      "artifactName": "StormStore-Setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
