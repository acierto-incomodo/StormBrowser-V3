{
  "name": "stormbrowser-v3-browser",
  "version": "1.2.2",
  "description": "StormBrowser - A modern browser by StormGamesStudios",
  "main": "main.js",
  "author": "StormGamesStudios <meliodas.aitor@gmail.com>",
  "scripts": {
    "start": "electron .",
    "clean": "if exist dist rd /s /q dist",
    "prebuild": "npm run clean",
    "build:win": "npm run prebuild && electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "npm run prebuild && electron-builder --win --linux"
  },
  "build": {
    "appId": "com.stormgamesstudios.stormbrowser",
    "productName": "StormBrowser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "acierto-incomodo",
      "repo": "StormBrowser-V3"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "renderer/assets/img/logo-256x256.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "flatpak",
        "zip"
      ],
      "executableName": "storm-browser",
      "icon": "renderer/assets/img/logo.svg",
      "category": "Network"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "23.08",
      "sdk": "org.freedesktop.Sdk",
      "finishArgs": [
        "--share=ipc",
        "--share=network",
        "--socket=x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--device=dri",
        "--filesystem=xdg-download"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "differentialPackage": true,
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-formatter-compact": "^9.0.1"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@ghostery/adblocker-webextension": "^2.18.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9"
  }
}
